// Merge these SiliconForge match blocks into your existing project rules.
// Do not replace rules for other apps (this Firebase project may be shared).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each authenticated engineer can read/write only their own profile.
    match /users/{userId} {
      allow read, create, update, delete: if request.auth != null
        && request.auth.uid == userId;

      // The complete SiliconForge vault is scoped to the authenticated owner.
      match /vault/{documentId} {
        allow read, create, update, delete: if request.auth != null
          && request.auth.uid == userId;
      }
    }

  }
}