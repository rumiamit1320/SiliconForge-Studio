rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each authenticated engineer can read/write only their own profile.
    match /users/{userId} {
      allow read, create, update, delete: if request.auth != null
        && request.auth.uid == userId;

      // The complete SiliconForge vault is scoped to the authenticated owner.
      match /vault/{documentId} {
        allow read, create, update, delete: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    // Deny all other documents by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}